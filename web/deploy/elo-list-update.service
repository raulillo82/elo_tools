[Unit]
Description=Descarga la lista FIDE para la web si hay una nueva
Requires=elo-web.service
After=elo-web.service

[Service]
Type=oneshot
# After a reboot the timer catches up at once, and elo-web counts as started as
# soon as podman is called, a few seconds before the container exists
ExecStartPre=/usr/bin/sh -c 'i=0; until /usr/bin/podman container exists elo-web; do i=$$((i+1)); [ $$i -gt 60 ] && exit 1; sleep 5; done'
# Inside the web's container: a second container on the same folder would take
# its SELinux label with :Z, and the web would lose access to its data
ExecStart=/usr/bin/podman exec elo-web python3 -m web.lists /data
